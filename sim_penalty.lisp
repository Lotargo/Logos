(require :asdf)
(make-package :cognitive-engine-noauto)
(load "v7/engine/engine.lisp")
(in-package :cognitive-engine)
(let* ((proc (uiop:launch-program (list "swipl" "-q" "-s" "v7/engine/daemon.pl") :input :stream :output :stream))
       (proc-cell (list proc)))
  (format t "Penalty: ~A~%" (check-with-prolog '(SEQ (H Q1) (SEQ (H Q1) (CNOT Q2 Q3))) :synthesis proc-cell))
  (format (uiop:process-info-input proc) "quit.~%")
  (force-output (uiop:process-info-input proc)))
(sb-ext:quit)
