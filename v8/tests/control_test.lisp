(require :asdf)
(defpackage :cognitive-engine (:use :cl))
(in-package :cognitive-engine)
(defvar *current-dataset* nil)
(defvar *regression-vars* nil)
(defvar *is-cli* t)
(load "v8/src/engine.lisp")

(format t "========================================================~%")
(format t "     STARTING COGNITIVE ENGINE CONTROL TESTS~%")
(format t "========================================================~%")

;; Test 1: Kepler's Third Law (T^2 = a^3)
(format t "~%--- Test 1: Kepler's Third Law ---~%")
(setf *regression-vars* '(a))
(setf *current-dataset* "v8/data/kepler_data.csv")
(run-engine-parallel '(mul a (mul a a)) :regression 1 1)

;; Test 2: Newtonian Gravity (F = m1*m2/r^2)
(format t "~%--- Test 2: Newtonian Gravity ---~%")
(setf *regression-vars* '(m1 m2 r))
(setf *current-dataset* "v8/data/gravity_data.csv")
(run-engine-parallel '(div (mul m1 m2) (mul r r)) :regression 1 1)

;; Test 3: Relativistic Kinematics (Lorentz Factor)
(format t "~%--- Test 3: Relativistic Kinematics ---~%")
(setf *regression-vars* '(v c))
(setf *current-dataset* "v8/data/relativity_data.csv")
(run-engine-parallel '(div 1 (sub 1 (div (mul v v) (mul c c)))) :regression 1 1)
